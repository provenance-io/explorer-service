
### Send Pulse backfill POST ALL request
POST http://localhost:8612//api/pulse/metric/backfill
Content-Type: application/x-www-form-urlencoded
timeout: 1800000

fromDate = 2025-01-21 &
toDate = 2025-02-01 &
types = PULSE_MARKET_CAP_METRIC &
types = PULSE_TRANSACTION_VOLUME_METRIC &
types = HASH_MARKET_CAP_METRIC &
types = HASH_SUPPLY_METRIC &
types = HASH_STAKED_METRIC &
types = HASH_CIRCULATING_METRIC &
types = PULSE_MARKET_CAP_METRIC &
types = PULSE_TRANSACTION_VOLUME_METRIC &
types = PULSE_FEES_AUCTIONS_METRIC &
types = PULSE_TODAYS_NAV_METRIC &
types = PULSE_TOTAL_NAV_METRIC &
types = PULSE_TRADE_SETTLEMENT_METRIC &
types = PULSE_TRADE_VALUE_SETTLED_METRIC &
types = PULSE_PARTICIPANTS_METRIC &
types = PULSE_MARGIN_LOANS_METRIC &
types = PULSE_DEMOCRATIZED_PRIME_POOLS_METRIC &
types = PULSE_COMMITTED_ASSETS_VALUE_METRIC &
types = PULSE_COMMITTED_ASSETS_METRIC &
types = FTS_LOAN_TOTAL_BALANCE_METRIC &
types = FTS_LOAN_TOTAL_COUNT_METRIC &
types = FTS_LOAN_PAYMENTS_METRIC &
types = FTS_LOAN_TOTAL_PAYMENTS_METRIC &
types = PULSE_ASSET_PRICE_SUMMARY_METRIC &
types = PULSE_ASSET_VOLUME_SUMMARY_METRIC



### Send Pulse backfill POST SOME request
POST http://localhost:8612//api/pulse/metric/backfill
Content-Type: application/x-www-form-urlencoded
timeout: 1800000

fromDate = 2025-04-08 &
toDate = 2025-04-08 &
types = PULSE_TRADING_TVL_METRIC

### Compare event-based Total NAV vs on-chain scope NAV snapshot
GET http://localhost:8612/api/pulse/metric/type/PULSE_TOTAL_NAV_METRIC?range=24h

###
GET http://localhost:8612/api/pulse/metric/type/PULSE_SCOPE_NAV_SNAPSHOT_METRIC?range=24h

### Snapshot-based TVL (committed + passport HASH + PULSE_SCOPE_NAV_SNAPSHOT_METRIC)
GET http://localhost:8612/api/pulse/metric/type/PULSE_TVL_SNAPSHOT_METRIC?range=24h

### Event-based TVL (committed + passport HASH + PULSE_TOTAL_NAV_METRIC)
GET http://localhost:8612/api/pulse/metric/type/PULSE_TVL_METRIC?range=24h

### Digital assets (hardcoded denoms from bank supply, HASH FDV, minus excluded uusd.trading addresses)
GET http://localhost:8612/api/pulse/metric/type/PULSE_DIGITAL_ASSETS_VALUE_METRIC?range=24h

### Digital asset summaries (hardcoded list; existing /asset/summary/list is still exchange-traded)
GET http://localhost:8612/api/pulse/asset/digital/summary/list

### Snapshot loan balance / count (scope_nav_snapshot filtered to LOANS specs)
GET http://localhost:8612/api/pulse/metric/type/PULSE_LOAN_BALANCE_SNAPSHOT_METRIC?range=24h
GET http://localhost:8612/api/pulse/metric/type/PULSE_LOAN_COUNT_SNAPSHOT_METRIC?range=24h

